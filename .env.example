# MongoDB Atlas Database URI Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/kjcmt-doc?retryWrites=true&w=majority

# NextAuth Security Secret (Can be generated with: openssl rand -base64 32)
NEXTAUTH_SECRET=your_nextauth_secret_key_here
NEXTAUTH_URL=http://localhost:3000

# Cloudinary Integration (Required for production cloud media hosting)
# If left blank, KJCMT DOC will fallback to local folder storage inside public/uploads/
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Discord Webhook (Optional - for event notifications to Discord channel)
DISCORD_WEBHOOK_URL=your_discord_webhook_url
